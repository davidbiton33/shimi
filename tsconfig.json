{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "rootDir": ".", "outDir": "dist", "skipLibCheck": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "declaration": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
